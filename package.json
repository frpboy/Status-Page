{
  "name": "zerpai-status-page",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "start:dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start -p 3002",
    "probe:once": "node --import tsx scripts/continuous-probe.js --once",
    "probe:daemon": "node --import tsx scripts/continuous-probe.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "test:watch": "node --import tsx --test --watch tests/**/*.test.ts",
    "ci": "npm run lint && npm run typecheck && npm test && npm run build && npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "lucide-react": "^0.453.0",
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.3.7",
    "postcss": "8.5.28",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
