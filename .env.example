# Zerpai Status Page Environment Configuration Template
# Copy this file to .env.local or set variables in Vercel Project Settings

# Primary API Base URL
NEXT_PUBLIC_API_URL=https://erp.zerpai.com/api/v1
NEXT_PUBLIC_SITE_TITLE=Zerpai System Infrastructure Status

# AWS Infrastructure Metadata Scope
AWS_REGION=ap-south-2
AWS_DEFAULT_REGION=ap-south-2
AWS_ECS_CLUSTER=zerpai-cluster
AWS_ECS_SERVICE=zerpai-backend-service
AWS_RDS_INSTANCE_ID=zerpai-db
AWS_COGNITO_USER_POOL_ID=ap-south-2_h1Yyx4i4b
AWS_EC2_BASTION_INSTANCE_ID=i-0e8150bdfa767cdb6

# 1. Option C: Neon PostgreSQL Serverless (Historical snapshots, incidents, daily uptime logs)
POSTGRES_URL=postgresql://username:password@ep-cool-name-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://username:password@ep-cool-name-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# 2. Option C: Upstash Redis (Ultra-fast Edge cache & live ping status)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token
